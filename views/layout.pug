doctype html
html(lang="en" xml:lang="en" xmlns= "http://www.w3.org/1999/xhtml")
  head
    title=`${title}`
    link(rel='stylesheet' href='/style.css')
    link(rel="stylesheet" href="https://fonts.googleapis.com/css2?family=VT323&display=swap")
